---
/**
 * La ruta dinámica que pinta las 263 páginas. Las rutas se conservan tal cual
 * estaban en WordPress: salen del campo `ruta` de cada JSON.
 *
 * La maquetación sale del árbol `bloques` (lo extrae scripts/arbol.py del
 * propio Elementor). Aquí no se decide nada de diseño: se pinta lo que trae.
 */
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';
import { pintar, seccionAmpliacion, rebajarH1 } from '../utils/render.js';
import { localidadDe } from '../utils/localidades.js';
import { anadirModelos, anadirFaq, tieneFaq } from '../utils/comunes.js';
import { sanearImagenes, existe } from '../utils/imagenes.js';
// medidas y fondo de cada foto (scripts/analizar-imagenes.mjs): un producto
// sobre fondo blanco se enseña entero, una foto de verdad se recorta
import fotos from '../data/imagenes.json';
import modelosM2Todos from '../data/modelos-m2.json';

export async function getStaticPaths() {
  const modulos = import.meta.glob('../content/pages/*.json', { eager: true });
  return Object.values(modulos).map((m) => {
    const p = m.default || m;
    const slug = p.ruta.replace(/^\/|\/$/g, '');
    return { params: { slug: slug || undefined }, props: { pagina: p } };
  });
}

const { pagina } = Astro.props;

// los rotulos "30 m2 / 90 m2" solo enlazan (y se pintan como tarjeta) si la
// pagina de ese modelo existe de verdad
const rutasExistentes = new Set(
  Object.values(import.meta.glob('../content/pages/*.json', { eager: true })).map((m) => (m.default || m).ruta),
);
const modelosM2 = Object.fromEntries(
  Object.entries(modelosM2Todos).filter(([k, v]) => /^\d+$/.test(k) && rutasExistentes.has(v.url)),
);

// 1. un solo H1 por página: el del héroe, con el título propio de la página
//    ("Casas Contenedores Madrid", "Casa con un Contenedor"…). Los
//    encabezados del contenido se quedan en su nivel original (h2, h3).
const bloques = structuredClone(pagina.bloques || []);
const h1 = pagina.titulo;
rebajarH1(bloques);

// Localidad de la pagina, para que la franja de cierre pueda nombrarla
// ("¿Quieres una casa contenedor en Lugo?"). Sale de la tabla que construye
// src/utils/localidades.js a partir del menu de provincias de WordPress: son
// los nombres que escribio el propietario, no una adivinanza sobre la palabra
// clave. Si la pagina no es de localidad, viene vacia y la franja usa el texto
// general.
const localidad = localidadDe(pagina.ruta);

// 2. las páginas de localidad llevan los mismos modelos que la portada (les
//    faltaban los de 15, 45, 60 y 75 m², y las de contenedores marítimos la
//    rejilla entera). Solo se AÑADE lo que no estaba.
if (localidad) anadirModelos(bloques, modelosM2);

// 3. la ampliación SEO (campo "ampliacion" del JSON: h2/h3 y FAQ nuevos) va
//    al FINAL del árbol; el contenido original no se toca. Sus preguntas no
//    abren una segunda sección: se meten en el acordeón de la página (el
//    suyo, o el de la portada si es de localidad y no tenía).
const conAcordeon = tieneFaq(bloques) || Boolean(localidad);
const ampliacion = seccionAmpliacion(pagina.ampliacion, { sinFaq: conAcordeon });
if (ampliacion) bloques.push(ampliacion.seccion);
anadirFaq(bloques, conAcordeon ? ampliacion?.faq || [] : [], { conPortada: Boolean(localidad) });
const faq = [...(pagina.faq || []), ...(ampliacion?.faq || [])];

// 4. se pinta el árbol; las imágenes pasan por el saneador (webp / marcador).
//    Las 4 páginas sin árbol de Elementor (las legales) van como texto corrido.
const hayArbol = bloques.length > 0;
//    La foto de cabecera del original ya la representa el heroe: no se repite.
const { html } = hayArbol
  ? pintar(bloques, { imagenes: (trozo) => sanearImagenes(trozo).html, omitir: pagina.hero?.src || '', existe, fotos, modelosM2 })
  : { html: `<div class="texto-corrido">${sanearImagenes(pagina.cuerpo).html}</div>` };

// 5. el marcador del formulario se parte para insertar el componente
const trozos = html.split(/<!--FORMULARIO:[^>]*?-->/);
---

<Base
  ruta={pagina.ruta}
  titulo={pagina.titulo}
  tituloSeo={pagina.tituloSeo}
  descripcion={pagina.descripcion}
  h1={h1}
  hero={pagina.hero}
  localidad={localidad}
  menu={pagina.menu}
  faq={faq}
  noindex={pagina.noindex}
>
  {trozos.map((trozo, i) => (
    <>
      <Fragment set:html={trozo} />
      {i < trozos.length - 1 && <Formulario />}
    </>
  ))}
</Base>
