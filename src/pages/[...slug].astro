---
/**
 * La ruta dinámica que pinta las 263 páginas. Las rutas se conservan tal cual
 * estaban en WordPress: salen del campo `ruta` de cada JSON.
 *
 * La maquetación sale del árbol `bloques` (lo extrae scripts/arbol.py del
 * propio Elementor). Aquí no se decide nada de diseño: se pinta lo que trae.
 */
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';
import CalculadoraHipoteca from '../components/CalculadoraHipoteca.astro';
import FormularioPasos from '../components/FormularioPasos.astro';
import CatalogoModelos from '../components/CatalogoModelos.astro';
import ServiciosContenedores from '../components/ServiciosContenedores.astro';

// componentes que una pagina puede pedir con un elemento { t: 'componente', nombre }
const COMPONENTES = {
  'calculadora-hipoteca': CalculadoraHipoteca,
  'formulario-pasos': FormularioPasos,
  'catalogo-modelos': CatalogoModelos,
  'servicios-contenedores': ServiciosContenedores,
};
import { pintar, seccionAmpliacion, rebajarH1 } from '../utils/render.js';
import { localidadDe } from '../utils/localidades.js';
import { anadirModelos, anadirFaq, tieneFaq, esCiudad, anadirZonas } from '../utils/comunes.js';
import { aplicarRenombres } from '../utils/renombres.js';
import { ordenarTipos } from '../utils/tipos.js';
import { anadirIntro, subirAlIntro } from '../utils/intro.js';
import { esMaritimos } from '../utils/hero.js';
import { sanearImagenes, existe } from '../utils/imagenes.js';
// medidas y fondo de cada foto (scripts/analizar-imagenes.mjs): un producto
// sobre fondo blanco se enseña entero, una foto de verdad se recorta
import fotos from '../data/imagenes.json';
import modelosM2Todos from '../data/modelos-m2.json';

export async function getStaticPaths() {
  const modulos = import.meta.glob('../content/pages/*.json', { eager: true });
  return Object.values(modulos).map((m) => {
    const p = m.default || m;
    const slug = p.ruta.replace(/^\/|\/$/g, '');
    return { params: { slug: slug || undefined }, props: { pagina: p } };
  });
}

const { pagina } = Astro.props;

// los rotulos "30 m2 / 90 m2" solo enlazan (y se pintan como tarjeta) si la
// pagina de ese modelo existe de verdad
const todasLasPaginas = Object.values(import.meta.glob('../content/pages/*.json', { eager: true })).map((m) => m.default || m);
const rutasExistentes = new Set(todasLasPaginas.map((p) => p.ruta));
// titulo de cada pagina, para rotular los enlaces entre zonas
const titulos = Object.fromEntries(todasLasPaginas.map((p) => [p.ruta, p.titulo]));
const modelosM2 = Object.fromEntries(
  Object.entries(modelosM2Todos).filter(([k, v]) => /^\d+$/.test(k) && rutasExistentes.has(v.url)),
);

// 1. un solo H1 por página: el del héroe, con el título propio de la página
//    ("Casas Contenedores Madrid", "Casa con un Contenedor"…). Los
//    encabezados del contenido se quedan en su nivel original (h2, h3).
const bloques = structuredClone(pagina.bloques || []);
const h1 = pagina.titulo;
rebajarH1(bloques);
// la rejilla de tipos de contenedor, en el orden que pidio el propietario:
// primero los estandar y luego los especiales (src/utils/tipos.js)
ordenarTipos(bloques);

// Localidad de la pagina, para que la franja de cierre pueda nombrarla
// ("¿Quieres una casa contenedor en Lugo?"). Sale de la tabla que construye
// src/utils/localidades.js a partir del menu de provincias de WordPress: son
// los nombres que escribio el propietario, no una adivinanza sobre la palabra
// clave. Si la pagina no es de localidad, viene vacia y la franja usa el texto
// general.
const localidad = localidadDe(pagina.ruta);
// página de ciudad (con localidad en el menú o de las que se quedaron fuera)
const ciudad = esCiudad(pagina.ruta, localidad);
// en las de ciudad, parrafos bajo el texto de entrada para que acabe a la
// altura del formulario (src/utils/intro.js)
if (ciudad) anadirIntro(bloques, { ruta: pagina.ruta, localidad, titulo: pagina.titulo, maritimo: esMaritimos(pagina.ruta, pagina.menu) });
// en las nuevas (guias, servicios, modelos), las primeras secciones del cuerpo
// suben junto al formulario hasta llenar su altura
subirAlIntro(bloques, pagina.ruta);

// 2. toda página con rejilla de tipos de casa (planos, permisos, precios,
//    pasos, ciudades...) enseña los mismos modelos que la portada: se le
//    añaden los de superficie que le falten. Las de localidad sin rejilla
//    (las de contenedores marítimos) la reciben entera. Solo se AÑADE.
anadirModelos(bloques, modelosM2, { completa: ciudad });

// 3. la ampliación SEO (campo "ampliacion" del JSON: h2/h3 y FAQ nuevos) va
//    al FINAL del árbol; el contenido original no se toca. Sus preguntas no
//    abren una segunda sección: se meten en el acordeón de la página (el
//    suyo, o el de la portada si es de localidad y no tenía).
const conAcordeon = tieneFaq(bloques) || ciudad;
// (copia: los renombres del paso 4 no deben tocar el JSON importado)
const ampliacion = seccionAmpliacion(pagina.ampliacion && structuredClone(pagina.ampliacion), { sinFaq: conAcordeon });
if (ampliacion?.seccion) bloques.push(ampliacion.seccion);
// las demás zonas de la misma provincia (o las provincias, si es una comunidad)
anadirZonas(bloques, pagina.ruta, titulos);
anadirFaq(bloques, conAcordeon ? ampliacion?.faq || [] : [], { conPortada: ciudad });
const faq = [...(pagina.faq || []), ...(ampliacion?.faq || [])].map((i) => ({ ...i }));
// las secciones que la pagina pide llevar al final (campo "alFinal": sus id,
// en orden), por detras de la ampliacion: en la portada, los servicios y la
// lista de provincias "Construcciones de casas con contenedores en España"
for (const id of pagina.alFinal || []) {
  const i = bloques.findIndex((b) => b.id === id);
  if (i >= 0) bloques.push(...bloques.splice(i, 1));
}

// 4. encabezados reescritos a propósito en algunas páginas (planos,
//    permisos, pasos: src/data/encabezados.json), sobre todo lo anterior
aplicarRenombres(pagina.ruta, bloques, faq);

// 5. se pinta el árbol; las imágenes pasan por el saneador (webp / marcador).
//    Las 4 páginas sin árbol de Elementor (las legales) van como texto corrido.
const hayArbol = bloques.length > 0;
//    La foto de cabecera del original ya la representa el heroe: no se repite.
const { html } = hayArbol
  ? pintar(bloques, { imagenes: (trozo) => sanearImagenes(trozo).html, omitir: pagina.hero?.src || '', existe, fotos, modelosM2 })
  : { html: `<div class="texto-corrido">${sanearImagenes(pagina.cuerpo).html}</div>` };

// 6. los marcadores (formulario de contacto y componentes) se parten para
//    insertar cada componente en su sitio
const partes = html.split(/<!--(FORMULARIO|COMPONENTE):([^>]*?)-->/);
const trozos = [];
for (let i = 0; i < partes.length; i += 3) {
  trozos.push({ html: partes[i], tras: partes[i + 1] === 'FORMULARIO' ? Formulario : partes[i + 1] === 'COMPONENTE' ? COMPONENTES[partes[i + 2]] : null });
}
---

<Base
  ruta={pagina.ruta}
  titulo={pagina.titulo}
  tituloSeo={pagina.tituloSeo}
  descripcion={pagina.descripcion}
  h1={h1}
  hero={pagina.hero}
  localidad={localidad}
  menu={pagina.menu}
  faq={faq}
  noindex={pagina.noindex}
>
  {trozos.map(({ html: trozo, tras: Componente }) => (
    <>
      <Fragment set:html={trozo} />
      {Componente && <Componente ruta={pagina.ruta} />}
    </>
  ))}
</Base>
