---
import Base from '../layouts/Base.astro';
import { WHATSAPP } from '../utils/site.js';

const wa = WHATSAPP;
---

<Base
  ruta="/gracias/"
  titulo="Mensaje recibido"
  tituloSeo="Mensaje recibido - Casas Contenedores"
  descripcion="Hemos recibido tu consulta y te contestamos lo antes posible."
  h1="Hemos recibido tu mensaje"
  noindex={true}
>
  <p>Gracias por escribirnos. Te contestamos lo antes posible.</p>
  <p>Si prefieres que sea ya, escríbenos por <a href={wa} rel="nofollow noopener" target="_blank">WhatsApp</a> o con el botón verde de la esquina.</p>
  <p><a class="boton boton-primario" href="/">Volver a la portada</a></p>
</Base>
