---
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cierre from '../components/Cierre.astro';
import Hero from '../components/Hero.astro';
import Migas from '../components/Migas.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { aWebp, existe } from '../utils/imagenes.js';
import { fotoHero, srcsetHero, TAMANOS_HERO } from '../utils/hero.js';
// El aspecto de la web. global.css pinta el chrome (cabecera, heroe, cierre,
// pie) y diseno.css el contenido (lo que escribe render.js). Las 26 hojas de
// Elementor ya NO se cargan: eran las que hacian que la web siguiera
// viendose igual que la vieja.
import '../styles/global.css';
import '../styles/diseno.css';

const {
  ruta = '/',
  titulo,
  tituloSeo,
  descripcion,
  h1,
  hero = {},
  faq = [],
  noindex = false,
  menu = '',
  localidad = '',
} = Astro.props;

const canonical = site.dominio + ruta;
// la foto de cabecera del original sigue siendo la imagen social (og:image)
const heroSrc = hero?.src && existe(hero.src) ? aWebp(hero.src) : '';
const fotoHeroe = fotoHero(ruta, menu);
const srcsetHeroe = srcsetHero(ruta, menu);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.nombre,
    url: site.dominio,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.nombre,
    url: site.dominio,
    email: site.email,
    contactPoint: [{
      '@type': 'ContactPoint',
      contactType: 'ventas',
      telephone: '+' + site.whatsapp,
      email: site.email,
      areaServed: 'ES',
      availableLanguage: 'es',
    }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: h1 || titulo,
    description: descripcion,
    url: canonical,
    inLanguage: 'es-ES',
    isPartOf: { '@type': 'WebSite', name: site.nombre, url: site.dominio },
  },
];

if (faq.length) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
    })),
  });
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloSeo || titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloSeo || titulo} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta property="og:url" content={canonical} />
    {heroSrc && <meta property="og:image" content={site.dominio + heroSrc} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* las dos letras que pintan lo primero que se ve (titular del heroe y
        texto); las demas variantes llegan con la hoja de fuentes */}
    <link rel="preload" href="/fonts/texto/archivo-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/texto/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {fotoHeroe && <link rel="preload" as="image" href={fotoHeroe} imagesrcset={srcsetHeroe || undefined} imagesizes={srcsetHeroe ? TAMANOS_HERO : undefined} fetchpriority="high" />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {site.verificaciones.google && (
      <meta name="google-site-verification" content={site.verificaciones.google} />
    )}

    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    {/* Solo las tipografias y los iconos. Las hojas de Elementor (el tema,
        el kit y una por pagina) ya no se cargan: el diseño lo pone ahora
        src/styles/diseno.css. */}
    <link rel="stylesheet" href="/css/comunes-final.css" />

    {site.analitica.ga4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analitica.ga4}`}></script>
        <script is:inline define:vars={{ ga4: site.analitica.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}

    {site.analitica.adsense && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.analitica.adsense}`}
        crossorigin="anonymous"
        data-overlays="bottom"
      ></script>
    )}
  </head>

  <body>
    <div id="wrap">
      <Header ruta={ruta} menu={menu} />

      <Hero titulo={h1 || titulo} ruta={ruta} localidad={localidad} menu={menu} />
      <Migas ruta={ruta} titulo={h1 || titulo} />

      <main id="main">
        <div class="entrada">
          <slot />
        </div>
      </main>

      <!-- Franja de cierre: contenido NUEVO, despues de todo lo original. -->
      <Cierre titulo={titulo} localidad={localidad} ruta={ruta} menu={menu} />

      <Footer />
    </div>
    <WhatsApp />
    <script>
      // visor de las galerias de fotos: solo actua si la pagina tiene una
      import '../scripts/galeria.js';
    </script>
  </body>
</html>
