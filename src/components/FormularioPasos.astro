---
/**
 * Presupuesto por pasos: tres pantallas cortas (que necesitas, detalles del
 * proyecto, contacto) en vez de un formulario largo. Envia por web3forms,
 * como Formulario.astro, con todas las respuestas en el correo.
 *
 * Sin JavaScript se ven los tres pasos seguidos y el formulario funciona
 * igual. Sin clave de web3forms (site.json) se ofrece el WhatsApp.
 */
import site from '../data/site.json';
const hayClave = Boolean(site.formulario.accessKey);
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappTexto)}`;
const { ruta = '/' } = Astro.props;
---

<section class="pasos-presupuesto" aria-labelledby="pp-titulo">
  <p class="pasos-presupuesto__antetitulo">Presupuesto en 3 pasos</p>
  <h2 id="pp-titulo" class="pasos-presupuesto__titulo">Cuéntanos tu proyecto y te preparamos el presupuesto</h2>

  <form class="formulario pasos-presupuesto__form" action={hayClave ? site.formulario.accion : undefined} method={hayClave ? 'POST' : undefined} data-pasos>
    {hayClave && (
      <>
        <input type="hidden" name="access_key" value={site.formulario.accessKey} />
        <input type="hidden" name="subject" value="Presupuesto por pasos desde casascontenedores.es" />
        <input type="hidden" name="from_name" value={site.nombre} />
        <input type="hidden" name="pagina" value={site.dominio + ruta} />
        <input type="hidden" name="redirect" value={site.dominio + site.formulario.gracias} />
        <input type="checkbox" name="botcheck" class="trampa" tabindex="-1" autocomplete="off" />
      </>
    )}

    <ol class="pasos-presupuesto__marcador" aria-hidden="true">
      <li data-marca="1">Qué necesitas</li>
      <li data-marca="2">Tu proyecto</li>
      <li data-marca="3">Contacto</li>
    </ol>

    <fieldset class="paso" data-paso="1">
      <legend>1. ¿Qué necesitas?</legend>
      <div class="opciones">
        <label class="opcion"><input type="radio" name="necesidad" value="Casa contenedor (vivienda)" required /> <span>Casa contenedor para vivir</span></label>
        <label class="opcion"><input type="radio" name="necesidad" value="Oficina, local o módulo" /> <span>Oficina, local o módulo</span></label>
        <label class="opcion"><input type="radio" name="necesidad" value="Comprar o alquilar un contenedor marítimo" /> <span>Comprar o alquilar un contenedor marítimo</span></label>
        <label class="opcion"><input type="radio" name="necesidad" value="Otro servicio" /> <span>Otro servicio (pintura, aislamiento, reparación…)</span></label>
      </div>
    </fieldset>

    <fieldset class="paso" data-paso="2">
      <legend>2. Tu proyecto</legend>
      <p class="campo">
        <label for="pp-tamano">Tamaño aproximado</label>
        <select id="pp-tamano" name="tamano">
          <option value="No lo sé todavía">No lo sé todavía</option>
          <option value="Hasta 30 m²">Hasta 30 m²</option>
          <option value="De 30 a 60 m²">De 30 a 60 m²</option>
          <option value="De 60 a 90 m²">De 60 a 90 m²</option>
          <option value="Más de 90 m²">Más de 90 m²</option>
          <option value="Un contenedor suelto">Un contenedor suelto (20 o 40 pies)</option>
        </select>
      </p>
      <p class="campo">
        <label for="pp-parcela">¿Tienes parcela?</label>
        <select id="pp-parcela" name="parcela">
          <option value="Sí, en suelo urbano">Sí, en suelo urbano</option>
          <option value="Sí, en suelo rústico">Sí, en suelo rústico</option>
          <option value="Estoy buscando">Estoy buscando</option>
          <option value="No lo sé">No lo sé</option>
          <option value="No aplica">No aplica</option>
        </select>
      </p>
      <p class="campo">
        <label for="pp-localidad">Provincia o localidad</label>
        <input id="pp-localidad" name="localidad" type="text" autocomplete="address-level2" required />
      </p>
      <p class="campo">
        <label for="pp-cuando">¿Cuándo quieres empezar?</label>
        <select id="pp-cuando" name="cuando">
          <option value="Lo antes posible">Lo antes posible</option>
          <option value="En los próximos meses">En los próximos meses</option>
          <option value="Solo me estoy informando">Solo me estoy informando</option>
        </select>
      </p>
    </fieldset>

    <fieldset class="paso" data-paso="3">
      <legend>3. Tus datos de contacto</legend>
      <p class="campo">
        <label for="pp-nombre">Tu nombre</label>
        <input id="pp-nombre" name="nombre" type="text" required autocomplete="name" />
      </p>
      <p class="campo">
        <label for="pp-email">Email</label>
        <input id="pp-email" name="email" type="email" required autocomplete="email" />
      </p>
      <p class="campo">
        <label for="pp-telefono">Teléfono</label>
        <input id="pp-telefono" name="telefono" type="tel" required autocomplete="tel" />
      </p>
      <p class="campo">
        <label for="pp-comentarios">Algo más que debamos saber (opcional)</label>
        <textarea id="pp-comentarios" name="comentarios" rows="3"></textarea>
      </p>
      <p class="consentimiento">
        <label>
          <input type="checkbox" name="consentimiento" required />
          He leído y acepto la <a href="/politica-privacidad/">política de privacidad</a>
        </label>
      </p>
    </fieldset>

    <div class="pasos-presupuesto__botones">
      <button type="button" class="boton-secundario" data-atras hidden>Atrás</button>
      <button type="button" data-siguiente hidden>Siguiente</button>
      {hayClave
        ? <button type="submit" data-enviar>Pedir presupuesto</button>
        : <a class="boton-enviar" href={wa} target="_blank" rel="noopener" data-enviar>Escríbenos por WhatsApp</a>}
    </div>
  </form>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-pasos]').forEach(function (form) {
      var pasos = form.querySelectorAll('[data-paso]');
      var marcas = form.querySelectorAll('[data-marca]');
      var atras = form.querySelector('[data-atras]');
      var sig = form.querySelector('[data-siguiente]');
      var enviar = form.querySelector('[data-enviar]');
      var actual = 0;
      form.classList.add('con-js');
      function mostrar(i) {
        actual = i;
        pasos.forEach(function (p, j) { p.hidden = j !== i; });
        marcas.forEach(function (m, j) { m.classList.toggle('hecho', j < i); m.classList.toggle('activo', j === i); });
        atras.hidden = i === 0;
        sig.hidden = i === pasos.length - 1;
        enviar.hidden = i !== pasos.length - 1;
      }
      function valido(i) {
        var campos = pasos[i].querySelectorAll('input, select, textarea');
        for (var k = 0; k < campos.length; k++) { if (!campos[k].checkValidity()) { campos[k].reportValidity(); return false; } }
        return true;
      }
      sig.addEventListener('click', function () { if (valido(actual)) { mostrar(actual + 1); pasos[actual].querySelector('input, select')?.focus(); } });
      atras.addEventListener('click', function () { mostrar(actual - 1); });
      mostrar(0);
    });
  })();
</script>

<style>
  .pasos-presupuesto {
    margin: 8px 0 32px;
    padding: 26px 26px 24px;
    background: #fff;
    border: 1px solid var(--linea);
    border-top: 4px solid var(--verde);
    border-radius: var(--radio-l);
    box-shadow: var(--sombra-2);
  }
  .pasos-presupuesto__antetitulo {
    margin: 0 0 6px;
    font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--verde-osc);
  }
  .pasos-presupuesto__titulo { margin: 0 0 18px; font-size: clamp(20px, 2.2vw, 26px); }
  .pasos-presupuesto__marcador {
    display: none; list-style: none; margin: 0 0 18px; padding: 0; gap: 8px;
    counter-reset: paso;
  }
  .con-js .pasos-presupuesto__marcador { display: flex; }
  .pasos-presupuesto__marcador li {
    flex: 1; padding: 8px 10px; border-radius: var(--radio);
    background: var(--papel-2); border: 1px solid var(--linea);
    font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--tenue);
  }
  .pasos-presupuesto__marcador li.activo { border-color: var(--verde); color: var(--verde-osc); background: var(--verde-claro); }
  .pasos-presupuesto__marcador li.hecho { color: var(--verde-osc); }
  .paso { border: 0; margin: 0 0 18px; padding: 0; min-width: 0; }
  .paso legend { padding: 0; margin: 0 0 12px; font-family: var(--titular); font-size: 18px; font-weight: 700; color: var(--ink); }
  .opciones { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .opcion {
    display: flex !important; align-items: center; gap: 10px;
    padding: 14px 14px; margin: 0 !important;
    border: 1px solid var(--linea); border-radius: var(--radio); cursor: pointer;
    font-family: var(--cuerpo) !important; font-size: 15px !important; font-weight: 500 !important;
    letter-spacing: normal !important; text-transform: none !important; color: var(--texto) !important;
    transition: border-color .15s ease, background .15s ease;
  }
  .opcion:hover { border-color: var(--verde); }
  .opcion:has(input:checked) { border-color: var(--verde); background: var(--verde-claro); }
  .opcion input { accent-color: var(--verde); margin: 0; }
  .pasos-presupuesto__botones { display: flex; gap: 10px; }
  .pasos-presupuesto__botones > * { flex: 1; }
  .pasos-presupuesto__botones [hidden] { display: none !important; }
  .formulario .boton-secundario {
    background: #fff; color: var(--ink); border: 1px solid var(--linea); box-shadow: none;
  }
  .formulario .boton-secundario:hover { background: var(--papel-2); color: var(--ink); }
  @media (max-width: 700px) {
    .pasos-presupuesto { padding: 20px 16px; }
    .opciones { grid-template-columns: 1fr; }
    .pasos-presupuesto__marcador li { font-size: 10px; padding: 7px 6px; }
  }
</style>
