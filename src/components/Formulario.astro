---
/**
 * Formulario único. Sustituye a los 251 formularios de Contact Form 7 que
 * traía el export. Envía por web3forms (sin servidor); mientras no haya
 * accessKey configurada en site.json, se muestra el correo de contacto.
 */
import site from '../data/site.json';
const { rotulo = '¿Te llamamos?' } = Astro.props;
const hayClave = Boolean(site.formulario.accessKey);
---

<section class="formulario" id="presupuesto">
  <p class="rotulo">{rotulo}</p>
  <p>Déjanos tu teléfono y te llamamos sin compromiso.</p>

  {hayClave ? (
    <form action={site.formulario.accion} method="POST">
      <input type="hidden" name="access_key" value={site.formulario.accessKey} />
      <input type="hidden" name="subject" value="Consulta desde casascontenedores.es" />
      <input type="hidden" name="redirect" value={site.dominio + site.formulario.gracias} />
      <input type="checkbox" name="botcheck" class="ancho-total" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="campos">
        <div>
          <label for="f-nombre">Nombre</label>
          <input id="f-nombre" name="nombre" type="text" required autocomplete="name" />
        </div>
        <div>
          <label for="f-telefono">Teléfono</label>
          <input id="f-telefono" name="telefono" type="tel" required autocomplete="tel" />
        </div>
        <div class="ancho-total">
          <label for="f-email">Correo electrónico</label>
          <input id="f-email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="ancho-total">
          <label for="f-mensaje">¿Qué necesitas?</label>
          <textarea id="f-mensaje" name="mensaje" rows="4"></textarea>
        </div>
        <div class="ancho-total">
          <label><input type="checkbox" name="consentimiento" required /> He leído y acepto la <a href="/politica-privacidad/">política de privacidad</a>.</label>
        </div>
        <div class="ancho-total">
          <button type="submit">Pedir presupuesto</button>
        </div>
      </div>
      <p class="aviso">Responsable: {site.titular.nombre}. Finalidad: atender tu consulta. No cedemos tus datos a terceros.</p>
    </form>
  ) : (
    <p>
      Escríbenos a <a href={`mailto:${site.email}`}>{site.email}</a> o por
      <a href={`https://wa.me/${site.whatsapp}`} rel="noopener"> WhatsApp</a>.
    </p>
  )}
</section>
