---
/**
 * Hero.astro — la franja de entrada de cada página, como en la maqueta.
 *
 * Va ENCIMA de todo lo original: no mueve, no cambia y no borra nada de lo
 * que ya había. Su titular es el <h1> de la página (el campo `titulo` del
 * JSON, el mismo que da nombre a la pestaña); los encabezados del contenido
 * conservan su nivel original, igual que en la web en vivo, que no tenía h1.
 *
 * El antetítulo, la entradilla y las fichas son texto de presentación y no
 * llevan ni una cifra. Ni precios ni plazos: eso entra cuando el propietario
 * pase los números reales.
 */
import { fotoHero, srcsetHero, TAMANOS_HERO, detalleHero, esMaritimos, esServicio } from '../utils/hero.js';

/* El titular del heroe es el <h1> de la pagina: su titulo propio ("Casas
 * Contenedores Madrid", "Casa con un Contenedor"…), asi cambia en cada
 * pestaña. Los encabezados del contenido se quedan en su nivel original. */
const { titulo = '', ruta = '', localidad = '', menu = '' } = Astro.props;

// La foto es siempre una limpia elegida a mano (ver src/utils/hero.js).
const foto = fotoHero(ruta, menu);
// la de casas va en varios anchos: el navegador elige la que necesita
const srcset = srcsetHero(ruta, menu);
const maritimos = esMaritimos(ruta, menu);
// las paginas de servicios para contenedores (pintura, aislamiento…)
const servicio = esServicio(ruta);
// alt y encuadre de la foto propia del servicio, si la tiene
const propia = detalleHero(ruta);

const antetitulo = servicio ? 'Servicios para contenedores · Toda España' : maritimos
  ? (localidad ? `Contenedores marítimos · ${localidad}` : 'Venta y alquiler · Toda España')
  : (localidad ? `Llave en mano · ${localidad}` : 'Llave en mano · Toda España');

const entradilla = servicio
  ? 'Pintura, aislamiento, instalaciones, seguridad, reparación y traslado para tu contenedor. Cuéntanos qué necesitas y te preparamos un presupuesto a medida antes de empezar.'
  : maritimos
  ? 'Contenedores marítimos nuevos y usados, con transporte y colocación en tu parcela. Te decimos el precio y el plazo antes de que te comprometas a nada.'
  : 'Diseñamos, fabricamos en taller y montamos tu vivienda en la parcela. Te decimos qué entra en el precio, qué va aparte y cuánto tarda, antes de que te comprometas a nada.';

/* Tres datos que NO son cifras: se pueden afirmar sin inventar nada. */
const fichas = servicio
  ? [['Contenedores', 'Nuevos, usados y transformados'], ['Presupuesto', 'A medida, antes de empezar'], ['Cobertura', 'Toda España']]
  : maritimos
  ? [['Entrega', 'En tu parcela'], ['Estado', 'Nuevos y usados'], ['Cobertura', 'Toda España']]
  : [['Proyecto y licencia', 'Los tramitamos nosotros'], ['Presupuesto', 'Cerrado antes de empezar'], ['Montaje', 'En tu parcela']];
---

<section class="hero" aria-label="Presentación">
  {foto && (
    <img
      class="hero-foto"
      src={foto}
      srcset={srcset || undefined}
      sizes={srcset ? TAMANOS_HERO : undefined}
      alt={propia ? propia.alt : maritimos || servicio ? 'Contenedor marítimo' : 'Casa construida con contenedores marítimos'}
      style={propia?.estilo}
      fetchpriority="high"
      decoding="async"
    />
  )}
  <div class="hero-in">
    <p class="antetitulo">{antetitulo}</p>
    <h1 class="hero-titulo">{titulo}</h1>
    <p class="hero-sub">{entradilla}</p>
    <div class="hero-botones">
      <a class="hero-boton" href="/presupuesto-casas-contenedores/">Pedir presupuesto</a>
      {servicio
        ? <a class="hero-boton hero-boton--s" href="/servicios/">Todos los servicios</a>
        : <a class="hero-boton hero-boton--s" href="/precios/">Ver precios</a>}
    </div>
    <ul class="hero-fichas">
      {fichas.map(([k, v]) => (
        <li><span class="k">{k}</span><span class="v">{v}</span></li>
      ))}
    </ul>
  </div>
</section>
<div class="corrugado" aria-hidden="true"></div>
